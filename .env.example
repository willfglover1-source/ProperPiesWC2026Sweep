# Copy this file to .env.local for a shared live sweep.
# Leave these blank to run locally with browser localStorage only.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional for automated fixture/result sync.
# Keep these server-side only: local scripts, CI secrets, or scheduled jobs.
SUPABASE_SERVICE_ROLE_KEY=
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_MATCHES_URL=https://api.football-data.org/v4/competitions/WC/matches

# Optional for automated betting odds sync.
ODDS_API_KEY=
ODDS_API_SPORT_KEY=soccer_fifa_world_cup
ODDS_API_REGIONS=au,uk,us
ODDS_API_MARKETS=h2h
ODDS_API_FORMAT=decimal
# Use this instead of regions if you want specific books.
# ODDS_API_BOOKMAKERS=pinnacle,sportsbet
