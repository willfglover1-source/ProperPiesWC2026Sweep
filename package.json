{
  "name": "proper-pies-wc2026-sweep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/init-env.mjs && npm install",
    "dev": "vite --host 127.0.0.1",
